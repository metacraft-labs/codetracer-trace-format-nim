# Preserve the effective workspace rules for this repository's finite census.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = unset

# Preserve aligned multiline Nim signatures under the existing project convention.
[*.nim]
indent_size = unset
